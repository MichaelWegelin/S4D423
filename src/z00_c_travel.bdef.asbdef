projection;
strict ( 2 );
use draft;
use side effects;
extensible;

define behavior for Z00_C_TRAVEL alias Travel
use etag
{
  use association _TravelItem { create; with draft; }

  use create;
  use update;
  use delete;

  use action cancel_travel;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action checkCustomer;

  use action adjustDuration;
  side effects {
    determine action checkCustomer
    executed on field CustomerId affects messages;

    determine action adjustDuration
    executed on field EndDate, field BeginDate
    affects field Duration, messages;

  }
}

define behavior for Z00_C_TRAVELITEM alias Item
extensible
{
  use update;
  use delete;

  use association _Travel { with draft; }
}